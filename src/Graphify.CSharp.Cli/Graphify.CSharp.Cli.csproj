<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Graphify.CSharp.Cli</RootNamespace>
    <AssemblyName>graphify-csharp</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>graphify-csharp</ToolCommandName>
    <PackageId>Graphify.CSharp</PackageId>
    <Version>0.1.5</Version>
    <Authors>Zach Saw</Authors>
    <Description>Roslyn-backed semantic C# caller and reference enricher for Graphify.</Description>
    <PackageTags>graphify;csharp;roslyn;static-analysis;call-graph</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zachsaw/graphify-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zachsaw/graphify-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <SdkRoslynPath>$(MSBuildToolsPath)/DotnetTools/dotnet-format</SdkRoslynPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Graphify.CSharp/Graphify.CSharp.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageReference Include="Humanizer.Core" Version="2.14.1" />
    <PackageReference Include="System.Composition" Version="10.0.10" />

    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(SdkRoslynPath)/Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(SdkRoslynPath)/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.Workspaces">
      <HintPath>$(SdkRoslynPath)/Microsoft.CodeAnalysis.Workspaces.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp.Workspaces">
      <HintPath>$(SdkRoslynPath)/Microsoft.CodeAnalysis.CSharp.Workspaces.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild">
      <HintPath>$(SdkRoslynPath)/Microsoft.CodeAnalysis.Workspaces.MSBuild.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild.Contracts">
      <HintPath>$(SdkRoslynPath)/Microsoft.CodeAnalysis.Workspaces.MSBuild.Contracts.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.ExternalAccess.RazorCompiler">
      <HintPath>$(SdkRoslynPath)/Microsoft.CodeAnalysis.ExternalAccess.RazorCompiler.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <None Include="$(SdkRoslynPath)/BuildHost-netcore/**/*"
          Link="BuildHost-netcore/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="tools/$(TargetFramework)/any/BuildHost-netcore/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(SdkRoslynPath)/BuildHost-net472/**/*"
          Link="BuildHost-net472/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="tools/$(TargetFramework)/any/BuildHost-net472/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
