<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Graphify.CSharp</RootNamespace>
    <AssemblyName>Graphify.CSharp</AssemblyName>
    <IsPackable>false</IsPackable>
    <PackageId>Graphify.CSharp.Core</PackageId>
  </PropertyGroup>

  <PropertyGroup>
    <RoslynPackageVersion>5.9.0</RoslynPackageVersion>
    <MSBuildPackageVersion>18.0.2</MSBuildPackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <RoslynPackageVersion>5.12.0</RoslynPackageVersion>
    <MSBuildPackageVersion>18.7.1</MSBuildPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.Switch" Version="3.2.0" />
    <PackageReference Include="Mediator.Switch.SourceGenerator" Version="3.2.0" PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Microsoft.Build" Version="$(MSBuildPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build.Framework" Version="$(MSBuildPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="$(MSBuildPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all"
                      Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynPackageVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="$(RoslynPackageVersion)" />
  </ItemGroup>
</Project>
