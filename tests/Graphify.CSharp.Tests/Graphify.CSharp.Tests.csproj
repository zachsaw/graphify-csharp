<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <SdkRoslynPath>$(MSBuildToolsPath)/DotnetTools/dotnet-format</SdkRoslynPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Graphify.CSharp/Graphify.CSharp.csproj" />
    <ProjectReference Include="../../src/Graphify.CSharp.Cli/Graphify.CSharp.Cli.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(SdkRoslynPath)/Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(SdkRoslynPath)/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.Workspaces">
      <HintPath>$(SdkRoslynPath)/Microsoft.CodeAnalysis.Workspaces.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp.Workspaces">
      <HintPath>$(SdkRoslynPath)/Microsoft.CodeAnalysis.CSharp.Workspaces.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild">
      <HintPath>$(SdkRoslynPath)/Microsoft.CodeAnalysis.Workspaces.MSBuild.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild.Contracts">
      <HintPath>$(SdkRoslynPath)/Microsoft.CodeAnalysis.Workspaces.MSBuild.Contracts.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.ExternalAccess.RazorCompiler">
      <HintPath>$(SdkRoslynPath)/Microsoft.CodeAnalysis.ExternalAccess.RazorCompiler.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateSdkRoslynAssets" BeforeTargets="ResolveReferences" Condition="'$(TargetFramework)' == 'net11.0'">
    <Error Condition="!Exists('$(SdkRoslynPath)/Microsoft.CodeAnalysis.CSharp.Workspaces.dll')"
           Text="The .NET 11 SDK's dotnet-format Roslyn workspace assemblies were not found at '$(SdkRoslynPath)'. Install the matching .NET 11 SDK before building the net11.0 tests." />
  </Target>
</Project>
